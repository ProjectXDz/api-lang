{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/api-server run build",
  "functions": {
    "artifacts/api-server/api/index.js": {
      "includeFiles": "artifacts/api-server/data/**"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/artifacts/api-server/api/index.js" }
  ]
}
